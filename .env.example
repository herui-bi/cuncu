# 复制为 .env 后按需修改（.env 不会提交到仓库）
# 运行项目：对应 config/environments/<项目>/ 目录名（dongying / liaohuibao / huiqubao）
TEST_ENV=dongying
# 运行阶段：项目目录下的文件名，默认 test
TEST_STAGE=test

# 浏览器是否无头运行：false=打开浏览器窗口，true=后台执行（CI 使用）
HEADLESS=false

# 登录账号，config.yaml 中通过 ${LOGIN_USER:-标准用户} 引用
LOGIN_USER=standard_user
LOGIN_PASSWORD=secret_sauce

# MySQL 测试库（config/environments/<项目>/test.yaml 中通过 ${DB_*} 引用）
DB_HOST=rm-uf637ba0514898t3sko.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_USER=insure_devloper
DB_PASSWORD=
DB_NAME=mth_insure_core

# 钉钉群机器人通知（群设置 → 机器人 → 自定义机器人，拿 Webhook 与加签密钥）
# 配置后每次 pytest 执行结束自动推送结果汇总与失败用例到群
DINGTALK_WEBHOOK=
# 机器人安全设置选择「加签」时填写密钥（SEC 开头），留空则不加签
DINGTALK_SECRET=
# 需要 @ 的手机号，逗号分隔，留空则不 @ 任何人
DINGTALK_AT_MOBILES=
